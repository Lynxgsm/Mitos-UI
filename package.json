{
  "name": "omni-system-ui",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @omni/core build && bun --filter @omni/web dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter @omni/core build && bun --filter '*' typecheck",
    "test": "bun --filter @omni/core test"
  },
  "devDependencies": {
    "shadcn": "^4.21.5",
    "typescript": "^7.0.2"
  }
}
