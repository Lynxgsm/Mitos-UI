{
  "name": "@omni/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/assets/stylex.css"
  },
  "scripts": {
    "build": "mitosis build && vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun run build && vitest run",
    "storybook": "mitosis build && storybook dev -p 6006",
    "build-storybook": "mitosis build && storybook build"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@builder.io/mitosis": "^0.14.1",
    "@builder.io/mitosis-cli": "^0.14.1",
    "@storybook/react-vite": "^10.6.2",
    "@stylexjs/unplugin": "^0.19.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "clsx": "^2.1.1"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
